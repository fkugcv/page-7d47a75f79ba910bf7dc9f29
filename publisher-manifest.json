repeat(2, 1fr);gap: 56px 48px}\n.faq-item h3 {font-size: 15px;color: #ffffff;margin-bottom: 10px;font-weight: 500}\n.faq-item p {font-size: 14px;color: #8c93a3;line-height: 1.7}\nfooter {border-top: 1px solid #16181f;padding: 48px 0;font-size: 12px;color: #555b68}\n.footer-container {max-width: 1200px;margin: 0 auto;padding: 0 32px;display: flex;justify-content: space-between;align-items: center}\n@media (max-width: 900px) {\n  .hero {grid-template-columns: 1fr;min-height: auto;padding: 64px 0 80px 0}\n  .specs-grid, .flow-steps, .client-info-grid, .faq-grid {grid-template-columns: 1fr;gap: 36px}\n  .hero-void {display: none}\n  .nav-container {padding: 0 20px}\n  main {padding: 0 20px}\n  .footer-container {padding: 0 20px;flex-direction: column;gap: 16px;align-items: flex-start}\n}\n</style><header>\n  <div class=\"nav-container\">\n    <div class=\"brand-mark\">FreeGate <span>//</span> Core</div>\n    <nav>\n      <ul>\n        <li><a href=\"#plans\">服务规格</a></li>\n        <li><a href=\"#setup\">配置流程</a></li>\n        <li><a href=\"#clients\">终端指引</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<main>\n  <section class=\"hero\">\n    <div class=\"hero-content\">\n      <span class=\"hero-tag\">System Routing Manual</span>\n      <h1>FreeGate 节点交付与数据中继系统</h1>\n      <p class=\"hero-desc\">本文档列明系统端口分配基准、多宿主路由策略及配套服务套餐。所有订阅与网络通讯均遵循标准加密传输协议，用于保障跨域数据链路的确定性与连通性。</p>\n      <div class=\"hero-actions\">\n        <a href=\"#plans\" class=\"btn-primary\">调取服务配置</a>\n        <a href=\"#setup\" class=\"btn-secondary\">查看对接规范</a>\n      </div>\n    </div>\n    <div class=\"hero-void\"></div>\n  </section>\n\n  <section id=\"specs\">\n    <div class=\"section-header\">\n      <span class=\"section-kicker\">Architecture</span>\n      <h2>核心调度指标</h2>\n    </div>\n    <div class=\"specs-grid\">\n      <article class=\"spec-block\">\n        <h3>多重接入隧道</h3>\n        <p>支持按用户身份分配独立订阅哈希，通过动态端点调度隔离并发流量，避免单点阻断扩散至全域集群。</p>\n      </article>\n      <article class=\"spec-block\">\n        <h3>配额计量模式</h3>\n        <p>系统按实际双向通道出入流量合并计算。周期重置日以账单生成时间戳为准，无多余隐藏扣除项目。</p>\n      </article>\n      <article class=\"spec-block\">\n        <h3>跨平台分发兼容</h3>\n        <p>输出格式标准遵循公有核心配置文件规范，支持直连解析，不锁定特定专有二进制运行环境。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"section-header\">\n      <span class=\"section-kicker\">Subscriptions</span>\n      <h2>节点资源与配额清单</h2>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>服务层级</th>\n            <th>结算周期基准</th>\n            <th>每月数据流量</th>\n            <th>并发终端上限</th>\n            <th>接入特性与路由组</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>\n              <div class=\"plan-name\">基础版</div>\n            </td>\n            <td>\n              <div class=\"price-tag\">¥15/月</div>\n              <div class=\"sub-price\">按年付仅需 ¥150/年</div>\n            </td>\n            <td>100GB</td>\n            <td>3 台</td>\n            <td>普通线路节点池，支持基础流媒体解析</td>\n          </tr>\n          <tr>\n            <td>\n              <div class=\"plan-name\">旗舰版 <span class=\"badge-featured\">推荐</span></div>\n            </td>\n            <td>\n              <div class=\"price-tag\">¥35/月</div>\n              <div class=\"sub-price\">按年付仅需 ¥350/年</div>\n            </td>\n            <td>300GB</td>\n            <td>5 台</td>\n            <td>IPLC 专线游戏加速优化，全节点原生流媒体解锁，7x24 优先工单响应</td>\n          </tr>\n          <tr>\n            <td>\n              <div class=\"plan-name\">团队版</div>\n            </td>\n            <td>\n              <div class=\"price-tag\">¥85/月</div>\n              <div class=\"sub-price\">按年付仅需 ¥850/年</div>\n            </td>\n            <td>1000GB</td>\n            <td>20 台</td>\n            <td>VIP 专属高带宽节点池，支持企业定制路由规则与专属客户经理</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"setup\">\n    <div class=\"section-header\">\n      <span class=\"section-kicker\">Deployment</span>\n      <h2>标准初始化流程</h2>\n    </div>\n    <div class=\"flow-steps\">\n      <div class=\"step-item\">\n        <span class=\"step-num\">01. 生成配置</span>\n        <h3>获取订阅凭证</h3>\n        <p>在用户控制台选定服务层级并确认订单后，系统将下发唯一的订阅 URL 及专属配置文件。</p>\n      </div>\n      <div class=\"step-item\">\n        <span class=\"step-num\">02. 导入核心</span>\n        <h3>载入本地客户端</h3>\n        <p>将订阅链接复制至经过验证的通用网络代理内核工具，触发远端节点清单同步解析。</p>\n      </div>\n      <div class=\"step-item\">\n        <span class=\"step-num\">03. 策略指定</span>\n        <h3>分流规则编排</h3>\n        <p>依据业务需求配置分流列表，指定直连网段与代理路由，避免内网服务受到流量穿透影响。</p>\n      </div>\n      <div class=\"step-item\">\n        <span class=\"step-num\">04. 连通校验</span>\n        <h3>链路延迟探针</h3>\n        <p>通过控制台内置测试脚本验证 TCP 与 UDP 端口响应状态，确立主备用链路切换顺序。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"section-header\">\n      <span class=\"section-kicker\">Endpoints</span>\n      <h2>终端支持说明</h2>\n    </div>\n    <div class=\"client-info-grid\">\n      <div class=\"client-text\">\n        <p>FreeGate 不提供捆绑式专有第三方可执行程序。用户可通过各平台成熟的开源网络核心程序（如 Clash、Sing-box、Surge、v2ray 等标准通用内核）加载订阅信息。</p>\n        <p>各操作系统环境均采用标准化配置文件结构下发，无需安装额外驱动即可直接依托本地 TUN/TAP 虚拟网卡设备运行。</p>\n      </div>\n      <div>\n        <ul class=\"protocol-list\">\n          <li>\n            <span class=\"protocol-name\">macOS / iOS</span>\n            <span class=\"protocol-desc\">支持通用配置文件直接导入，兼容系统 Network Extension</span>\n          </li>\n          <li>\n            <span class=\"protocol-name\">Windows 10 / 11</span>\n            <span class=\"protocol-desc\">通过系统服务驱动接管本地流量，需授予管理员网络权限</span>\n          </li>\n          <li>\n            <span class=\"protocol-name\">Linux (amd64 / arm64)</span>\n            <span class=\"protocol-desc\">支持 systemd 守护进程运行模式及无头服务器终端调用</span>\n          </li>\n          <li>\n            <span class=\"protocol-name\">OpenWrt / 路由系统</span>\n            <span class=\"protocol-desc\">支持软路由旁路部署模式，实现局域网设备无感透明分流</span>\n          </li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"section-header\">\n      <span class=\"section-kicker\">Troubleshooting</span>\n      <h2>常见问题解答</h2>\n    </div>\n    <div class=\"faq-grid\">\n      <div class=\"faq-item\">\n        <h3>多设备在线数量是如何判定的？</h3>\n        <p>系统网关在传输层动态维护客户端公网出口 IP 与哈希映射表。若同一时刻发起握手的独立公网网络环境超出套餐上限，后发起的连接请求将被限流或返回连接超时错误。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>流量配额用尽后的处理逻辑是什么？</h3>\n        <p>当月统计周期内已用传输量达到账单配额后，节点权限将被临时挂起，数据连接返回阻断状态。用户可选择追加流量附加包或等待下一个账单周期的自动重置。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>团队版定制路由具体支持哪些范畴？</h3>\n        <p>团队版允许为特定组织实体划分独立出口池，并支持结合企业固定办公公网 IP 建立安全访问白名单，以保障特定企业级私有云或协同平台的访问合规。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>如何排查订阅信息更新失败的情况？</h3>\n        <p>请首先检查本机系统时间是否已通过 NTP 服务校准同步，时差超过 60 秒可能导致 TLS 握手失败；其次确认本地网络环境是否能正常解析订阅接口的 DNS 地址。</p>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"footer-container\">\n    <div>FreeGate Network Specification. All technical parameters are subject to the active subscription profile.</div>\n    <div>Strictly Structured • Static Reference Manual</div>\n  </div>\n</footer>",
